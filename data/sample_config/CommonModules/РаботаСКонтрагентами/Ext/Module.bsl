Функция НайтиКонтрагентаПоИНН(ИНН) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ИНН = &ИНН";
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

Функция ИННКорректен(ИНН) Экспорт

	Длина = СтрДлина(ИНН);
	Если Длина <> 10 И Длина <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(ИНН, " ") = 0;

КонецФункции

Процедура ЗаполнитьРеквизитыКонтрагента(Контрагент, ИНН) Экспорт

	Если Не ИННКорректен(ИНН) Тогда
		ВызватьИсключение "Некорректный ИНН: " + ИНН;
	КонецЕсли;

	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	КонтрагентОбъект.ИНН = ИНН;
	КонтрагентОбъект.Записать();

КонецПроцедуры

Функция ПолучитьСальдоКонтрагента(Контрагент, НаДату) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВзаиморасчетыОстатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.Взаиморасчеты.Остатки(&НаДату, Контрагент = &Контрагент) КАК ВзаиморасчетыОстатки";
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;

	Возврат 0;

КонецФункции
